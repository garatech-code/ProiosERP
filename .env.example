# Archivo de Entorno de Ejemplo / Environment Variables Example
# Copia este archivo a ".env" en la raíz del proyecto y ajusta los valores para tu entorno.

# --- Django ---
DEBUG=1
SECRET_KEY=replace-with-your-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL Database (Local via Docker) ---
POSTGRES_DB=proios_db
POSTGRES_USER=proios_user
POSTGRES_PASSWORD=proios_pass

# --- PostgreSQL Database (External like Neon / Render) ---
# DB_HOST=ep-example.aws.neon.tech
# DB_PORT=5432
# DB_SSLMODE=require

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=jwt-secret-replace-in-production
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Integración de Correos (SMTP / IMAP) ---
# Requiere contraseñas de aplicación si usas Gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-email-de-empresa@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password

IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- VITE Frontend ---
# Las variables para el frontend deben empezar con VITE_
VITE_API_URL=http://localhost/api
