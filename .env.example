# Archivo de Entorno de Ejemplo / Environment Variables Example
# Copia este archivo a ".env" en la raíz del proyecto y ajusta los valores para tu entorno.

# --- Django ---
DEBUG=1
SECRET_KEY=replace-with-your-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL Database ---
POSTGRES_DB=proios_db
POSTGRES_USER=proios_user
POSTGRES_PASSWORD=proios_pass
# DB_PORT=5432

# --- Redis & Celery ---
REDIS_URL=redis://redis:6379/0

# --- JWT Authentication ---
JWT_SECRET_KEY=jwt-secret-replace-in-production
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- VITE Frontend ---
# Las variables para el frontend deben empezar con VITE_
# VITE_API_URL=http://localhost/api
